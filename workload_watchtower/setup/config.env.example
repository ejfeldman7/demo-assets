# Workload Watchtower — deployment config.
#
#   cp setup/config.env.example setup/config.env   &&   edit the values below
#
# setup/config.env is gitignored (it can hold SMTP credentials). setup/setup.sh sources it,
# passes the values to the bundle and app, and writes back the dashboard URLs after deploy.

# ── Databricks connection ────────────────────────────────────────────────────
DATABRICKS_PROFILE="my-workspace"                       # a `databricks auth profiles` entry
WORKSPACE_HOST="https://my-workspace.cloud.databricks.com"
WORKSPACE_LABEL="my-workspace"                          # shown in the app's top-right chip/avatar

# ── Compute + Unity Catalog ──────────────────────────────────────────────────
WAREHOUSE_ID="0123456789abcdef"                         # a serverless SQL warehouse ID
UC_SCHEMA="main.workload_monitoring"                    # <catalog>.<schema> for history tables
                                                        # (created by setup if absent)

# ── Lakebase (Autoscaling) ───────────────────────────────────────────────────
# Reuse an existing project or let setup create this one. The endpoint path + host are
# derived/discovered from these three by setup — you don't set them by hand.
LAKEBASE_PROJECT="workload-watchtower"                  # projects/<this>
LAKEBASE_BRANCH="production"
LAKEBASE_ENDPOINT_ID="primary"
LAKEBASE_SCHEMA="watchtower"                            # Postgres schema for triage state

# ── App + poller ─────────────────────────────────────────────────────────────
APP_NAME="workload-watchtower"                          # Databricks App name (mints its SP)
POLLER_JOB_NAME="watchtower-poller"                     # must match the job name in databricks.yml
SECRET_SCOPE="watchtower"                               # secret scope for SMTP settings

# ── Agentic features (Triage Copilot + Ask Watchtower) ───────────────────────
WT_MODEL="databricks-claude-sonnet-5"                   # any chat serving endpoint in the workspace

# ── Optional: seed an assignable roster ──────────────────────────────────────
# Path to a JSON file of [{ "name","email","role" }] (role: admin|triager|oncall).
# Leave empty to start with no roster (cards begin unassigned; assign them in the app).
SEED_MEMBERS_JSON=""                                    # e.g. setup/it_members.json

# ── Optional: Monitoring dashboard ───────────────────────────────────────────
DEPLOY_MONITORING="true"                                # deploy the 6-page AI/BI Cost & Usage dashboard
# Filled in automatically by setup after the dashboard is published — leave blank:
DASHBOARD_URL=""
DASHBOARD_EMBED_URL=""

# ── Optional: SMTP email automations ─────────────────────────────────────────
# If true, setup writes these into the secret scope. Leave false to skip email entirely
# (critical findings still appear on the board; nothing is emailed).
CONFIGURE_SMTP="false"
SMTP_HOST=""                                            # e.g. smtp.sendgrid.net
SMTP_PORT="587"                                         # 587 (STARTTLS) or 465 (implicit TLS)
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""                                            # From: address (defaults to SMTP_USER)
